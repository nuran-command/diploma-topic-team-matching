PROJECT_NAME="Diploma Topic & Team Matching API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_random_secure_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diploma_matching_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diploma_matching_db

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

VITE_API_URL=http://localhost:8000/api/v1
